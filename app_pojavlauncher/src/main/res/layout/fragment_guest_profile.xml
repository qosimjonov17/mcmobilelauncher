<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/background_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_25sdp"
        android:paddingVertical="@dimen/_20sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guest_profile_title"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/guest_profile_description" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/guest_nickname_edit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:hint="@string/guest_profile_nickname_hint"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:inputType="textPersonName"
            android:maxLength="24"
            android:textSize="@dimen/_16ssp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/guest_continue_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/padding_heavy"
            android:text="@string/guest_profile_continue"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
